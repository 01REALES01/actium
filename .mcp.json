{
  "mcpServers": {
    "v0": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.v0.dev",
        "--header",
        "Authorization: Bearer ${V0_API_KEY}"
      ]
    },
    "stitch": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://stitch.googleapis.com/mcp"
      ]
    },
    "supabase": {
      "command": "bash",
      "args": [
        "scripts/mcp-supabase.sh"
      ]
    }
  }
}
