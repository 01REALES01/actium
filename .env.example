# =============================================================================
# ACTIUM | Variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` (desarrollo) o configura estas variables en
# el panel de tu hosting (Vercel → Settings → Environment Variables) en
# produccion. NUNCA subas valores reales al repositorio.
#
# Los valores se obtienen en: Supabase Dashboard → Project Settings → API
# =============================================================================

# URL del proyecto Supabase (publica). Ej: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave anonima publica (anon/public). Respeta RLS. Segura para el cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave service_role (SECRETA). SALTA RLS por completo.
# Solo en el servidor. NUNCA con prefijo NEXT_PUBLIC_. No exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
